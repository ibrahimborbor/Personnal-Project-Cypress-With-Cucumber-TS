{
  "name": "project-1",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "cy:run:headed": "cypress run --headed",
    "cy:feature": "cypress run --spec \"cypress/e2e/features/**/*.feature\"",
    "cy:run:report": "cypress run --headless",
    "report:clean": "node -e \"const fs=require('fs');fs.rmSync('cypress/reports/cucumber-json',{recursive:true,force:true});\"",
    "report:generate": "node cypress/reports/generate-cucumber-report.js",
    "test:report": "npm run report:clean && npm run cy:run:report && npm run report:generate",
    "allure:clean": "node -e \"const fs=require('fs');fs.rmSync('cypress/reports/allure-results',{recursive:true,force:true});fs.rmSync('cypress/reports/allure-report',{recursive:true,force:true});\"",
    "allure:generate": "allure generate cypress/reports/allure-results --clean -o cypress/reports/allure-report",
    "allure:open": "allure open cypress/reports/allure-report",
    "test:allure": "npm run allure:clean && npm run cy:run:report && npm run allure:generate",
    "test": "npm run cy:run"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "cypress-cucumber-preprocessor": {
    "stepDefinitions": [
      "cypress/e2e/step_definitions/**/*.ts"
    ],
    "json": {
      "enabled": true,
      "output": "cypress/reports/cucumber-json/cucumber-report.json"
    }
  },
  "devDependencies": {
    "@badeball/cypress-cucumber-preprocessor": "^24.0.1",
    "@bahmutov/cypress-esbuild-preprocessor": "^2.2.8",
    "@types/node": "^25.5.0",
    "allure-commandline": "^2.38.1",
    "allure-cypress": "^3.6.0",
    "cypress": "^15.13.0",
    "esbuild": "^0.27.4",
    "multiple-cucumber-html-reporter": "^3.10.0",
    "typescript": "^5.9.3"
  }
}
